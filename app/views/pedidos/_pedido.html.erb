<li class="cartao pedido pedido-<%= pedido.status %>">
  <div class="pedido-topo">
    <span class="pedido-hora"><%= hora_br(pedido.horario) || "—" %><small><%= l(pedido.data, format: "%d/%m") %></small></span>
    <div class="pedido-quem">
      <%= link_to pedido, class: "pedido-nome" do %><%= pedido.nome_cliente %> <small><%= pedido.numero %></small><% end %>
      <p class="pedido-itens"><%= resumo_itens(pedido).presence || truncate(pedido.descricao, length: 90) %></p>
    </div>
    <div class="pedido-lado">
      <strong class="pedido-total"><%= reais(pedido.total) %></strong>
      <% if pedido.fotos_count.positive? %>
        <span class="pedido-fotos" title="Fotos anexadas"><%= icone(:camera) %><%= pedido.fotos_count %></span>
      <% end %>
    </div>
  </div>
  <div class="pedido-meio">
    <%= progresso_status(pedido) %>
    <div class="selos"><%= selo_entrega(pedido) %><%= selo_pagamento(pedido) %></div>
  </div>
  <div class="pedido-acoes">
    <%= render "pedidos/escolher_status", pedido: pedido %>
    <% unless pedido.pago? || pedido.cancelado? %>
      <%= button_to pagamento_pedido_path(pedido, valor: "pago"), method: :patch, class: "botao botao-pagar", form: { class: "form-inline" } do %>
        <span>Marcar pago</span>
      <% end %>
    <% end %>
  </div>
</li>

<%= form_with model: pedido, local: true, class: "formulario cartao", id: "form-pedido" do |form| %>
  <%= render "shared/erros", registro: pedido %>

  <fieldset class="grupo">
    <legend>Cliente</legend>
    <div class="campo">
      <%= form.label :cliente_id, "Cliente cadastrado" %>
      <%= form.select :cliente_id,
            options_for_select(@clientes.map { |c| [c.nome, c.id, { "data-nome": c.nome, "data-whatsapp": c.celular, "data-endereco": c.endereco&.resumo.to_s }] }, pedido.cliente_id),
            { include_blank: "— Cliente novo / não cadastrado —" }, id: "pedido_cliente_id" %>
    </div>
    <div class="linha">
      <div class="campo">
        <%= form.label :nome_cliente %>
        <%= form.text_field :nome_cliente, required: true, autocomplete: "off" %>
      </div>
      <div class="campo">
        <%= form.label :whatsapp %>
        <%= form.telephone_field :whatsapp, placeholder: "(82) 99999-9999", inputmode: "tel" %>
      </div>
    </div>
  </fieldset>

  <fieldset class="grupo">
    <legend>Quando e como</legend>
    <div class="linha">
      <div class="campo">
        <%= form.label :data %>
        <%= form.date_field :data, required: true %>
      </div>
      <div class="campo">
        <%= form.label :horario %>
        <%= form.time_field :horario %>
      </div>
    </div>
    <div class="escolha" role="radiogroup" aria-label="Entrega ou retirada">
      <% Pedido::TIPOS_ENTREGA.each do |valor, nome| %>
        <label class="escolha-opcao"><%= form.radio_button :tipo_entrega, valor %> <span><%= nome %></span></label>
      <% end %>
    </div>
    <div class="campo" id="campo-endereco">
      <%= form.label :endereco_entrega %>
      <%= form.text_area :endereco_entrega, rows: 2, placeholder: "Rua, número, bairro e ponto de referência" %>
    </div>
  </fieldset>

  <fieldset class="grupo">
    <legend>Itens <small>(escolha do cadastro ou escreva)</small></legend>
    <div id="itens-pedido" class="itens-pedido">
      <%= form.fields_for :itens do |f| %>
        <%= render "pedidos/item_campos", f: f, produtos: @produtos %>
      <% end %>
    </div>
    <template id="modelo-item">
      <%= form.fields_for :itens, PedidoItem.new, child_index: "NOVO_ITEM" do |f| %>
        <%= render "pedidos/item_campos", f: f, produtos: @produtos %>
      <% end %>
    </template>
    <button type="button" class="botao" id="adicionar-item">+ Adicionar item</button>
    <div class="campo">
      <%= form.label :descricao %>
      <%= form.text_area :descricao, rows: 5, placeholder: "Detalhes: sabores, recheios, tamanho, decoração, frase no bolo, alergias…" %>
    </div>
  </fieldset>

  <fieldset class="grupo">
    <legend>Pagamento</legend>
    <div class="escolha" role="radiogroup" aria-label="Pagamento">
      <% Pedido::PAGAMENTOS.each do |valor, nome| %>
        <label class="escolha-opcao"><%= form.radio_button :pagamento, valor %> <span><%= nome %></span></label>
      <% end %>
    </div>
    <div class="linha">
      <div class="campo">
        <%= form.label :forma_pagamento %>
        <%= form.select :forma_pagamento, Pedido::FORMAS_PAGAMENTO.invert, include_blank: "—" %>
      </div>
      <div class="campo">
        <%= form.label :status %>
        <%= form.select :status, Pedido::STATUS.invert %>
      </div>
    </div>
    <div class="linha">
      <div class="campo">
        <%= form.label :taxa_entrega %>
        <%= form.number_field :taxa_entrega, min: 0, step: "0.01", inputmode: "decimal" %>
      </div>
      <div class="campo">
        <%= form.label :desconto %>
        <%= form.number_field :desconto, min: 0, step: "0.01", inputmode: "decimal" %>
      </div>
    </div>
    <p class="total-pedido">Total: <strong id="total-pedido"><%= reais(Pedidos::Calculadora.new(pedido).total) %></strong></p>
  </fieldset>

  <div class="acoes acoes-fixas">
    <%= form.submit "Salvar pedido", class: "botao botao-principal" %>
    <%= link_to "Cancelar", (pedido.persisted? ? pedido_path(pedido) : pedidos_path), class: "botao" %>
  </div>
<% end %>

<script>
  (function () {
    var form = document.getElementById("form-pedido");
    if (!form) return;
    var lista = document.getElementById("itens-pedido");
    var modelo = document.getElementById("modelo-item");
    var cliente = document.getElementById("pedido_cliente_id");
    var dinheiro = new Intl.NumberFormat("pt-BR", { style: "currency", currency: "BRL" });
    var num = function (el) { return el ? (parseFloat(String(el.value).replace(",", ".")) || 0) : 0; };

    function atualizarTotal() {
      var total = 0;
      lista.querySelectorAll("[data-item]").forEach(function (item) {
        var remover = item.querySelector("[data-remover]");
        if (remover && remover.checked) return;
        var temItem = item.querySelector("[data-produto]").value || item.querySelector("[data-nome]").value.trim();
        if (temItem) total += num(item.querySelector("[data-qtd]")) * num(item.querySelector("[data-preco]"));
      });
      total += num(form.querySelector("#pedido_taxa_entrega")) - num(form.querySelector("#pedido_desconto"));
      document.getElementById("total-pedido").textContent = dinheiro.format(Math.max(total, 0));
    }

    function atualizarEntrega() {
      var entrega = form.querySelector("input[name='pedido[tipo_entrega]']:checked");
      document.getElementById("campo-endereco").hidden = !(entrega && entrega.value === "entrega");
      if (entrega && entrega.value === "entrega" && cliente && cliente.value) {
        var area = form.querySelector("#pedido_endereco_entrega");
        var end = cliente.selectedOptions[0].dataset.endereco;
        if (area && !area.value && end) area.value = end;
      }
    }

    form.addEventListener("change", function (e) {
      var alvo = e.target;
      if (alvo.matches("[data-produto]")) {
        var item = alvo.closest("[data-item]");
        var opcao = alvo.selectedOptions[0];
        var preco = item.querySelector("[data-preco]");
        if (opcao && opcao.dataset.valor) preco.value = opcao.dataset.valor;
        item.querySelector("[data-nome]").value = opcao && opcao.value ? opcao.text : "";
      }
      if (alvo === cliente && cliente.value) {
        var d = cliente.selectedOptions[0].dataset;
        form.querySelector("#pedido_nome_cliente").value = d.nome || "";
        form.querySelector("#pedido_whatsapp").value = d.whatsapp || "";
      }
      if (alvo.name === "pedido[tipo_entrega]" || alvo === cliente) atualizarEntrega();
      atualizarTotal();
    });
    form.addEventListener("input", atualizarTotal);

    form.addEventListener("click", function (e) {
      if (e.target.matches("[data-limpar]")) {
        var item = e.target.closest("[data-item]");
        item.querySelectorAll("input:not([type=hidden]), select").forEach(function (c) { c.value = c.matches("[data-qtd]") ? 1 : ""; });
        atualizarTotal();
      }
    });

    document.getElementById("adicionar-item").addEventListener("click", function () {
      var html = modelo.innerHTML.replace(/NOVO_ITEM/g, String(Date.now()));
      lista.insertAdjacentHTML("beforeend", html);
      var novo = lista.lastElementChild.querySelector("select");
      if (novo) novo.focus();
    });

    atualizarEntrega();
    atualizarTotal();
  })();
</script>

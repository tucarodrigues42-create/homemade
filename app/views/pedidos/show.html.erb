<% content_for :title, "Pedido #{@pedido.numero}" %>
<div class="cabecalho">
  <h1>Pedido <%= @pedido.numero %></h1>
  <div class="item-acoes">
    <%= link_to "Editar", edit_pedido_path(@pedido), class: "botao" %>
    <%= botao_excluir @pedido, pergunta: "Excluir o pedido #{@pedido.numero}?" %>
  </div>
</div>

<div class="selos selos-grandes"><%= selo_entrega(@pedido) %><%= selo_pagamento(@pedido) %></div>

<section class="cartao etapas etapas-<%= @pedido.status %>" aria-labelledby="titulo-etapa">
  <div class="etapas-topo">
    <h2 id="titulo-etapa" class="bloco-titulo">Etapa do pedido</h2>
    <span class="selo selo-<%= @pedido.status %>"><%= @pedido.status_nome %></span>
  </div>

  <% if @pedido.cancelado? %>
    <p class="discreto">Este pedido foi cancelado e não entra na produção nem no faturamento.</p>
    <%= render "pedidos/escolher_status", pedido: @pedido, classe: "escolher-status-largo" %>
  <% else %>
    <ol class="linha-etapas">
      <% Pedido::FLUXO.each_with_index do |st, i| %>
        <% estado = if i + 1 < @pedido.passo then "feito" elsif i + 1 == @pedido.passo then "atual" else "depois" end %>
        <li class="linha-etapa linha-etapa-<%= estado %> linha-etapa-<%= st %>">
          <%= button_to status_pedido_path(@pedido, status: st), method: :patch, class: "linha-etapa-botao", disabled: estado == "atual",
                        form: { class: "form-bloco" }, "aria-current": (estado == "atual" ? "step" : nil),
                        "aria-label": "Mudar para #{Pedido::STATUS[st]}" do %>
            <span class="linha-etapa-bolinha"><%= estado == "feito" ? icone(:check) : i + 1 %></span>
            <span class="linha-etapa-nome"><%= st == "entregue" && !@pedido.entrega? ? "Retirado" : Pedido::STATUS[st] %></span>
          <% end %>
        </li>
      <% end %>
    </ol>
    <%= render "pedidos/escolher_status", pedido: @pedido, classe: "escolher-status-largo" %>
    <% if @pedido.status == "entregue" %>
      <p class="tudo-certo">Pedido concluído<%= " e pago" if @pedido.pago? %>.</p>
    <% end %>
    <p class="discreto dica">Toque no botão acima (ou numa bolinha) e escolha a etapa.</p>
  <% end %>

  <div class="pagamento-escolha" role="group" aria-label="Pagamento">
    <span class="pagamento-rotulo">Pagamento</span>
    <div class="segmentos">
      <%= button_to "A receber", pagamento_pedido_path(@pedido, valor: "pendente"), method: :patch,
                    class: "segmento #{'segmento-ativo segmento-pendente' unless @pedido.pago?}", disabled: !@pedido.pago?, form: { class: "form-bloco" } %>
      <%= button_to pagamento_pedido_path(@pedido, valor: "pago"), method: :patch,
                    class: "segmento #{'segmento-ativo segmento-pago' if @pedido.pago?}", disabled: @pedido.pago?, form: { class: "form-bloco" } do %>
        <%= icone(:check) if @pedido.pago? %> Pago
      <% end %>
    </div>
  </div>

</section>

<div class="colunas">
  <section class="cartao bloco">
    <h2 class="bloco-titulo">Cliente</h2>
    <dl class="detalhes">
      <dt>Nome</dt>
      <dd><%= @pedido.cliente ? link_to(@pedido.nome_cliente, @pedido.cliente) : @pedido.nome_cliente %></dd>
      <dt>WhatsApp</dt>
      <dd><%= @pedido.whatsapp_formatado.presence || "—" %></dd>
      <dt>Quando</dt>
      <dd><%= dia_da_semana(@pedido.data) %><%= " às #{hora_br(@pedido.horario)}" if @pedido.horario %></dd>
      <dt><%= @pedido.tipo_entrega_nome %></dt>
      <dd class="texto-longo"><%= @pedido.entrega? ? @pedido.endereco_entrega : "Cliente busca na loja" %></dd>
      <dt>Pagamento</dt>
      <dd><%= @pedido.pago? ? "Pago" : "A receber" %><%= " · #{@pedido.forma_pagamento_nome}" if @pedido.forma_pagamento.present? %></dd>
    </dl>
    <% if (url = whatsapp_pedido_url(@pedido)) %>
      <%= link_to url, class: "botao botao-whatsapp", target: "_blank", rel: "noopener" do %><%= icone(:whatsapp) %>&nbsp;Enviar resumo no WhatsApp<% end %>
    <% end %>
  </section>

  <section class="cartao bloco">
    <h2 class="bloco-titulo">Itens</h2>
    <% if @pedido.itens.any? %>
      <table class="tabela-itens">
        <tbody>
          <% @pedido.itens.each do |item| %>
            <tr>
              <td class="num"><strong><%= item.quantidade %>×</strong></td>
              <td><%= item.nome %><% if item.observacao.present? %><br><small class="discreto"><%= item.observacao %></small><% end %></td>
              <td class="num"><%= reais(item.subtotal) %></td>
            </tr>
          <% end %>
        </tbody>
        <tfoot>
          <tr><td></td><td>Subtotal</td><td class="num"><%= reais(@pedido.subtotal) %></td></tr>
          <% if @pedido.taxa_entrega.positive? %><tr><td></td><td>Taxa de entrega</td><td class="num"><%= reais(@pedido.taxa_entrega) %></td></tr><% end %>
          <% if @pedido.desconto.positive? %><tr><td></td><td>Desconto</td><td class="num">− <%= reais(@pedido.desconto) %></td></tr><% end %>
          <tr class="linha-total"><td></td><td>Total</td><td class="num"><%= reais(@pedido.total) %></td></tr>
        </tfoot>
      </table>
    <% else %>
      <p class="discreto">Sem itens cadastrados. Total: <strong><%= reais(@pedido.total) %></strong></p>
    <% end %>
    <% if @pedido.descricao.present? %>
      <h3 class="subtitulo">Descrição</h3>
      <p class="texto-longo"><%= @pedido.descricao %></p>
    <% end %>
    <%= render "pedidos/fotos", pedido: @pedido, fotos: @fotos %>
  </section>
</div>

<p><%= link_to "← Voltar para os pedidos", pedidos_path(periodo: "dia", dia: @pedido.data) %></p>

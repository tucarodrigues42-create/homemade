<% content_for :title, "Mais" %>
<%= render "shared/cabecalho", titulo: "Mais opções" %>
<ul class="lista-menu">
  <li><%= link_to dashboard_path, class: "lista-menu-item" do %><%= icone(:grafico) %><span>Dashboard de faturamento</span><%= icone(:seta, classe: "icone seta") %><% end %></li>
  <li><%= link_to agendas_path, class: "lista-menu-item" do %><%= icone(:agenda) %><span>Agenda</span><%= icone(:seta, classe: "icone seta") %><% end %></li>
  <li><%= link_to produtos_path, class: "lista-menu-item" do %><%= icone(:produtos) %><span>Produtos</span><%= icone(:seta, classe: "icone seta") %><% end %></li>
  <li><%= link_to enderecos_path, class: "lista-menu-item" do %><%= icone(:enderecos) %><span>Endereços de entrega</span><%= icone(:seta, classe: "icone seta") %><% end %></li>
  <li><%= link_to ingredientes_path, class: "lista-menu-item" do %><%= icone(:ingredientes) %><span>Ingredientes</span><%= icone(:seta, classe: "icone seta") %><% end %></li>
  <li><%= link_to usuarios_path, class: "lista-menu-item" do %><%= icone(:usuarios) %><span>Usuários e senhas</span><%= icone(:seta, classe: "icone seta") %><% end %></li>
  <li><%= link_to edit_usuario_path(current_user), class: "lista-menu-item" do %><%= icone(:usuarios) %><span>Minha conta (<%= current_user.email %>)</span><%= icone(:seta, classe: "icone seta") %><% end %></li>
  <li>
    <%= button_to sessions_path, method: :delete, class: "lista-menu-item lista-menu-sair", form: { class: "form-bloco" } do %>
      <%= icone(:sair) %><span>Sair do sistema</span>
    <% end %>
  </li>
</ul>

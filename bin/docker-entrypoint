#!/bin/bash -e
# Antes de abrir o servidor: aplica as migrações e garante o usuário administrador.
if [ "${@: -1:1}" == "./bin/rails server -b 0.0.0.0 -p ${PORT}" ] || [[ "$*" == *"rails server"* ]]; then
  # Duas instâncias podem subir juntas e tentar migrar ao mesmo tempo (o pooler do
  # Neon não aceita trava de migração). Se uma falhar, espera a outra e tenta de novo.
  ./bin/rails db:prepare || { sleep 5; ./bin/rails db:prepare; }
  ./bin/rails db:seed
fi
exec "${@}"
